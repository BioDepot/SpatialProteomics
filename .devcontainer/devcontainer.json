{
  "postStartCommand": "if [ ! -L /data ]; then [ -d /data ] && sudo mv /data /data.orphaned.$(date +%s); sudo ln -s \"$PWD\" /data; fi; chmod +x restart_bwb.sh && docker run --rm -p 6080:6080 -v \"$PWD\":/data -v /var/run/docker.sock:/var/run/docker.sock -v /tmp/.X11-unix:/tmp/.X11-unix --privileged --group-add root -e STARTING_WORKFLOW=/data/workflows/BwbSpatialProteomics/BwbSpatialProteomics.ows biodepot/bwb"
}
